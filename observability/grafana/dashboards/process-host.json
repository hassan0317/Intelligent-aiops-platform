{
  "uid": "proc-host",
  "title": "Resources & Saturation",
  "description": "Per-service process saturation: CPU (% of a core), resident memory, thread count, context switches and in-flight requests. CPU matches the HighProcessCPU threshold alert (>85% of a core).",
  "tags": ["aiops", "resources"],
  "timezone": "Asia/Karachi",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "links": [
    { "title": "AIOps dashboards", "type": "dashboards", "tags": ["aiops"], "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(process_memory_usage, job)",
        "query": { "qryType": 1, "query": "label_values(process_memory_usage, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2, "sort": 1, "includeAll": true, "allValue": ".+", "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "name": "Firing alerts", "datasource": { "type": "prometheus", "uid": "prometheus" }, "enable": true, "expr": "ALERTS{alertstate=\"firing\"}", "iconColor": "red", "titleFormat": "{{alertname}}", "textFormat": "{{service}} · {{severity}}", "tagKeys": "service,severity,fault", "step": "30s" }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Peak CPU (% of a core)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "max(100 * sum by (job) (rate(process_cpu_time{job=~\"$service\"}[$__rate_interval])))" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Total resident memory",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "purple" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(process_memory_usage{job=~\"$service\"})" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Threads",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(process_thread_count{job=~\"$service\"})" } ]
    },
    {
      "id": 4, "type": "stat", "title": "In-flight requests",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background_solid", "graphMode": "area", "justifyMode": "center", "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(http_server_active_requests{job=~\"$service\"})" } ]
    },

    { "id": 100, "type": "row", "title": "CPU", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 } },
    {
      "id": 5, "type": "timeseries", "title": "CPU (% of a core) by service",
      "description": "100 × rate(process_cpu_time) = cores-used × 100. Dashed red line = the 85% HighProcessCPU alert threshold.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "dashed" } }, "color": { "mode": "palette-classic" }, "unit": "percent", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 85 } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean", "max"] } },
      "targets": [ { "refId": "A", "expr": "100 * sum by (job) (rate(process_cpu_time{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "CPU by mode (user vs system)",
      "description": "Stacked user/system CPU seconds rate per service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 30, "gradientMode": "none", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "normal", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } }, "color": { "mode": "palette-classic" }, "unit": "percent", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean"] } },
      "targets": [ { "refId": "A", "expr": "100 * sum by (job, type) (rate(process_cpu_time{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}} · {{type}}" } ]
    },

    { "id": 101, "type": "row", "title": "Memory & threads", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "id": 7, "type": "timeseries", "title": "Resident memory by service",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } }, "color": { "mode": "palette-classic" }, "unit": "bytes", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (process_memory_usage{job=~\"$service\"})", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Thread count by service",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } }, "color": { "mode": "palette-classic" }, "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (process_thread_count{job=~\"$service\"})", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Context switches / s by service",
      "description": "rate(process_context_switches) — rising involuntary switches indicate CPU contention / scheduler pressure.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } }, "color": { "mode": "palette-classic" }, "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job, type) (rate(process_context_switches{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}} · {{type}}" } ]
    },

    { "id": 102, "type": "row", "title": "Concurrency", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 10, "type": "timeseries", "title": "In-flight (active) requests by service",
      "description": "http.server.active_requests — concurrency / queueing. Rises when a service slows under load.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } }, "color": { "mode": "palette-classic" }, "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "mappings": [] }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (http_server_active_requests{job=~\"$service\"})", "legendFormat": "{{job}}" } ]
    }
  ]
}
