{
  "uid": "aiops-overview",
  "title": "AIOps Platform — Overview",
  "description": "Single-pane-of-glass for the self-healing service mesh: SLOs, RED golden signals, latency distribution, saturation, logs and active alerts. Span metrics keyed by service_name; process metrics by job; both equal the OTel service name.",
  "tags": ["aiops", "overview"],
  "timezone": "Asia/Karachi",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"]
  },
  "links": [
    {
      "title": "AIOps dashboards",
      "type": "dashboards",
      "tags": ["aiops"],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(process_memory_usage, job)",
        "query": { "qryType": 1, "query": "label_values(process_memory_usage, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "iconColor": "red",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{service}} · severity={{severity}} · fault={{fault}}",
        "tagKeys": "service,severity,fault,source",
        "step": "30s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services Up",
      "description": "Number of services currently pushing metrics (derived from process_memory_usage presence — the mesh does not expose a scrape `up`).",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "center", "textMode": "value_and_name", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "count(group by (job) (process_memory_usage{job=~\"$service\"}))", "instant": true, "legendFormat": "services" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (success ratio)",
      "description": "Share of server-span requests that did not end in STATUS_CODE_ERROR over the dashboard range.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0, "max": 100,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 99.9 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "area", "justifyMode": "center", "textMode": "value", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "100 * (1 - (sum(rate(calls{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\",service_name=~\"$service\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])), 1))", "legendFormat": "availability" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request rate",
      "description": "Aggregate server-span request rate across selected services.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "sum(rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "req/s" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Aggregate server-span error ratio across selected services.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "area", "justifyMode": "center", "textMode": "value", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "(100 * sum(rate(calls{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\",service_name=~\"$service\"}[$__rate_interval])) / clamp_min(sum(rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])), 1)) or vector(0)", "legendFormat": "error %" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 latency",
      "description": "Worst server-span p95 across selected services (span-derived).",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "min": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 250 }, { "color": "red", "value": 500 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "area", "justifyMode": "center", "textMode": "value", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "max(histogram_quantile(0.95, sum by (le, service_name) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval]))))", "legendFormat": "p95" } ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Incidents",
      "description": "Alerts currently firing in Prometheus (threshold lane). AI-confirmed incidents are pushed straight to Alertmanager and shown on the custom console / Alertmanager UI.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "justifyMode": "center", "textMode": "value", "orientation": "auto"
      },
      "targets": [ { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true, "legendFormat": "firing" } ]
    },

    {
      "id": 100,
      "type": "row",
      "title": "Golden Signals — RED (per service)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by service",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "color": { "mode": "palette-classic" },
          "unit": "reqps", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (service_name) (rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service_name}}" } ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate (%) by service",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "unit": "percent", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 10 } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "100 * (sum by (service_name) (rate(calls{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\",service_name=~\"$service\"}[$__rate_interval])) or (0 * sum by (service_name) (rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))) / clamp_min(sum by (service_name) (rate(calls{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])), 1)", "legendFormat": "{{service_name}}" } ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p95 latency (ms) by service",
      "description": "Span-derived server-span p95. The dashed line marks the LAT_FLOOR_MS=375 the AI detector uses as an absolute latency floor.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "unit": "ms", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 250 }, { "color": "red", "value": 375 } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{service_name}}" } ]
    },

    {
      "id": 101,
      "type": "row",
      "title": "Latency distribution",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency percentiles (selected services, aggregate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "color": { "mode": "palette-classic" },
          "unit": "ms", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 11,
      "type": "heatmap",
      "title": "Server-span latency heatmap",
      "description": "Distribution of server-span durations over time, built from the spanmetrics duration histogram (le buckets in ms).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (le) (rate(duration_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}" } ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "reverse": false, "exponent": 0.5, "fill": "dark-orange" },
        "yAxis": { "unit": "ms", "axisPlacement": "left", "reverse": false },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 }
      },
      "fieldConfig": { "defaults": { "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false }, "scaleDistribution": { "type": "linear" } } }, "overrides": [] }
    },

    {
      "id": 102,
      "type": "row",
      "title": "Saturation & Resources",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU (% of a core) by service",
      "description": "rate(process_cpu_time) × 100 = cores-used × 100, matching the HighProcessCPU alert (>85% of a core).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "unit": "percent", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 85 } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "100 * sum by (job) (rate(process_cpu_time{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Resident memory by service",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "color": { "mode": "palette-classic" },
          "unit": "bytes", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (process_memory_usage{job=~\"$service\"})", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "In-flight requests by service",
      "description": "http.server.active_requests — concurrency / queue saturation signal.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "color": { "mode": "palette-classic" },
          "unit": "short", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] } },
      "targets": [ { "refId": "A", "expr": "sum by (job) (http_server_active_requests{job=~\"$service\"})", "legendFormat": "{{job}}" } ]
    },

    {
      "id": 103,
      "type": "row",
      "title": "Logs & Active Alerts",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Error log lines / min by service (Loki)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 60, "gradientMode": "none", "showPoints": "never", "spanNulls": false, "stacking": { "mode": "normal", "group": "A" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "thresholdsStyle": { "mode": "off" } },
          "color": { "mode": "palette-classic" },
          "unit": "short", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "sum"] } },
      "targets": [ { "refId": "A", "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\"} |~ \"(?i)error\" [1m])) or (0 * sum by (service_name) (count_over_time({service_name=~\"$service\"} [1m])))", "legendFormat": "{{service_name}}" } ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Firing alerts",
      "description": "Prometheus threshold-lane alerts currently firing. Empty = healthy.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "instant": true, "format": "table" } ],
      "transformations": [
